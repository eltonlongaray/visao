{
  "hosting": {
    "site": "estilo-falcon",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "node_modules/**",
      "ia/**",
      "cloudflare/**",
      "testes/**"
    ],
    "rewrites": [
      {
        "source": "/triagem/**",
        "destination": "/triagem.html"
      },
      {
        "source": "/agenda-online/**",
        "destination": "/agenda.html"
      },
      {
        "source": "/rifa/**",
        "destination": "/rifa.html"
      },
      {
        "source": "/ficha/**",
        "destination": "/ficha.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(agenda-online|triagem|ficha|rifa)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/ale",
        "destination": "/triagem/V83?utm_source=instagram",
        "type": 302
      },
      {
        "source": "/ale-insta",
        "destination": "/triagem/V83?utm_source=instagram",
        "type": 302
      },
      {
        "source": "/ale-zap",
        "destination": "/triagem/V83?utm_source=whatsapp",
        "type": 302
      }
    ]
  }
}